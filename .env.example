# Semascope settings. Do not copy this file to .env: run `./oss init`, which writes .env
# with generated secrets (mode 600) and the settings below that it chooses. This file lists
# every setting, with its default; edit .env, then `./oss up` to apply.
#
# The `change-me` values are placeholders: the server, workers and beat refuse to start
# while a required secret is empty or a placeholder. Any setting can instead be read from a
# file named by <NAME>_FILE (Docker secrets: `./oss init --secrets-dir`, compose.secrets.yaml).
# A commented line shows the default; settings marked (compose) are set by compose.yaml for
# the containers and matter only for `uv run` against a development stack.

# --- Identity, size, image --------------------------------------------------------------------
SEMASCOPE_HOST=localhost
# host port Caddy listens on (oss init --https-port)
SEMASCOPE_HTTPS_PORT=8443
# small | medium | large: what `oss init --size` chose; the heaps and worker lines below follow it
SEMASCOPE_SIZE=small
SOLR_HEAP=1g
NEO4J_HEAP=1g
TIKA_HEAP=1g
# worker processes and the worker container's memory cap (small 1 and 4g, medium 2 and 6g,
# large 4 and 12g); a pool process above its share of the cap is replaced after its task
SEMASCOPE_WORKER_CONCURRENCY=1
SEMASCOPE_WORKER_MEMORY=4g
# the release to run; empty means the version of this checkout (compose.yaml)
# SEMASCOPE_IMAGE_TAG=
# host folder mounted read-only at /import for `./oss index` and filesystem sources
SEMASCOPE_IMPORT_DIR=./data/import
# development only: skips the secret check and allows plain-HTTP cookies
# SEMASCOPE_DEBUG=false

# --- Secrets (oss init generates all of them) ---------------------------------------------------
SEMASCOPE_SECRET_KEY=change-me
# keyed hash of pseudonymised graph entities; never rotated (empty: the secret key, as before rc.4)
SEMASCOPE_PSEUDONYM_KEY=change-me
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
SOLR_PASSWORD=change-me
VALKEY_PASSWORD=change-me
SEMASCOPE_ADMIN_PASSWORD=change-me
SEMASCOPE_API_TOKEN=oss_change-me
# Grafana and Flower in compose.observe.yaml (user admin)
GRAFANA_PASSWORD=change-me
# with `oss init --secrets-dir`: the folder holding one file per secret (compose.secrets.yaml)
# SEMASCOPE_SECRETS_DIR=

# --- Access -----------------------------------------------------------------------------------
# role of a signed-in user on a collection they hold no role on: none (each collection is
# read only by the users given a role on it) or reader (every signed-in user reads everything)
SEMASCOPE_DEFAULT_ROLE=none
# folders inside the containers that file-reading sources may read (comma-separated)
# SEMASCOPE_SOURCE_ROOTS=/import,/app/packs/demo/corpus
# private hosts or CIDR ranges that web, feed, SPARQL and S3 sources and webhooks may reach
# SEMASCOPE_ALLOWED_PRIVATE_HOSTS=

# --- Single sign-on (OpenID Connect; local accounts always work) --------------------------------
# SEMASCOPE_OIDC_NAME=Company SSO
# SEMASCOPE_OIDC_SERVER_URL=https://login.example.com/realms/example
# SEMASCOPE_OIDC_CLIENT_ID=
# SEMASCOPE_OIDC_CLIENT_SECRET=
# a first sign-in creates the account (false: only accounts an administrator made)
# SEMASCOPE_OIDC_AUTO_SIGNUP=true
# global role of accounts created by sign-on: none, reader, curator, editor or admin
# SEMASCOPE_OIDC_DEFAULT_ROLE=none

# --- Runtime and providers (oss init --runtime cpu|gpu|remote) ----------------------------------
SEMASCOPE_RUNTIME=cpu
# embeddings: fastembed (bundled) | openai | sidecar
SEMASCOPE_EMBEDDER=fastembed
SEMASCOPE_EMBED_MODEL=BAAI/bge-small-en-v1.5
# SEMASCOPE_EMBED_BASE_URL=
# SEMASCOPE_EMBED_API_KEY=
# the model's vector length, when `oss doctor` cannot tell it
# SEMASCOPE_EMBED_DIMENSIONS=
# ONNX Runtime providers for fastembed (the gpu runtime sets CUDA first)
# SEMASCOPE_EMBED_PROVIDERS=CPUExecutionProvider
# where the image keeps its baked models
# SEMASCOPE_MODEL_CACHE=/app/models
# named entities: spacy (bundled) | gliner (gpu image) | remote
SEMASCOPE_NER_PROVIDER=spacy
# SEMASCOPE_NER_MODEL=fastino/gliner2-large-v1
# SEMASCOPE_NER_BASE_URL=
# SEMASCOPE_NER_API_KEY=
# text extraction: tika (bundled, with OCR) | mineru
SEMASCOPE_EXTRACT_PROVIDER=tika
# SEMASCOPE_EXTRACT_BASE_URL=
# SEMASCOPE_EXTRACT_API_KEY=
# bearer token every remote service gets (a per-stage key above overrides it)
# SEMASCOPE_REMOTE_API_KEY=

# --- Worker reliability (docs/operations.md#crashes-and-recovery; 0 means the default) -----------
# hard limit of one document task: 1800 s, 5400 s with MinerU
SEMASCOPE_TASK_TIME_LIMIT_S=0
# Valkey redelivers an unacknowledged task after this: the time limit plus 900 s
SEMASCOPE_VISIBILITY_TIMEOUT_S=0
# interrupted starts before a document is held as failed
SEMASCOPE_MAX_ATTEMPTS=3
# a document `processing` this long on no live worker is queued again
SEMASCOPE_STALE_AFTER_S=300
# a pool process above this resident size is replaced; 0 works it out from the memory cap
SEMASCOPE_WORKER_MAX_MEMORY_MB=0

# --- Map ----------------------------------------------------------------------------------------
# XYZ raster tile URL for the map background; empty for none (offline and air-gapped installs)
SEMASCOPE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SEMASCOPE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- Optional answer generation (any OpenAI-compatible endpoint) ---------------------------------
# SEMASCOPE_LLM_BASE_URL=
# SEMASCOPE_LLM_API_KEY=
# SEMASCOPE_LLM_MODEL=

# --- Service addresses (compose) ----------------------------------------------------------------
# DATABASE_URL=postgresql://semascope@localhost:5432/semascope
# VALKEY_URL=redis://localhost:6379/0
# SOLR_URL=http://localhost:8983/solr
# SOLR_USER=semascope
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# TIKA_URL=http://localhost:9998
# SEMASCOPE_API_URL=http://server:8000
# SEMASCOPE_DATA_DIR=./data

# --- Sign-in lockout, rate limits, request caps, audit (server hardening) ---
# SEMASCOPE_LOGIN_MAX_FAILURES=5
# SEMASCOPE_LOGIN_MAX_FAILURES_PER_IP=50
# SEMASCOPE_LOGIN_LOCKOUT_S=900
# SEMASCOPE_RATE_LIMITS=
# SEMASCOPE_TRUSTED_PROXIES=1
# SEMASCOPE_UPLOAD_MAX_MB=512
# SEMASCOPE_REQUEST_MAX_MB=10
# SEMASCOPE_RECONCILE_PUBLIC=false
# SEMASCOPE_AUDIT_RETENTION_DAYS=365
# Caddy (compose variables)
# SEMASCOPE_TLS=internal
# SEMASCOPE_ADMIN_ALLOW=0.0.0.0/0 ::/0
# SEMASCOPE_UPLOAD_LIMIT=2GB
