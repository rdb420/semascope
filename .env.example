# Copy to .env (or run ./oss init, which generates the secrets for you).
# Every value here is read by compose.yaml and by the application settings.

SEMASCOPE_HOST=localhost
SEMASCOPE_HTTPS_PORT=8443
SEMASCOPE_SIZE=small            # small | medium | large: sets JVM heaps and worker counts
SEMASCOPE_WORKER_CONCURRENCY=1   # worker processes: small 1, medium 2, large 4 (set by ./oss init --size)
SEMASCOPE_WORKER_MEMORY=4g       # worker memory cap: small 4g, medium 6g, large 12g
SEMASCOPE_IMPORT_DIR=./data/import   # host folder the workers can read; `./oss index` paths must be inside it

# Generated secrets (./oss init). Never commit the real .env.
SEMASCOPE_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
SOLR_PASSWORD=change-me
SEMASCOPE_ADMIN_PASSWORD=change-me      # first admin user, created on first start
SEMASCOPE_API_TOKEN=oss_change-me       # bearer token the CLI uses

# Service versions are pinned in compose.yaml; override only for testing.
SOLR_HEAP=1g
NEO4J_HEAP=1g
TIKA_HEAP=1g

# Optional: an OpenAI-compatible endpoint for answer generation (off by default)
SEMASCOPE_LLM_BASE_URL=
SEMASCOPE_LLM_API_KEY=
SEMASCOPE_LLM_MODEL=

# Map background tiles: an XYZ raster URL template. Empty = no base map (offline installs).
SEMASCOPE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SEMASCOPE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Optional single sign-on (OpenID Connect). Leave empty for local accounts only.
SEMASCOPE_OIDC_NAME=
SEMASCOPE_OIDC_SERVER_URL=
SEMASCOPE_OIDC_CLIENT_ID=
SEMASCOPE_OIDC_CLIENT_SECRET=
SEMASCOPE_DEFAULT_ROLE=reader          # role of signed-in users without explicit roles: reader | curator | editor | admin
