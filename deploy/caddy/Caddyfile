{$SEMASCOPE_HOST}:443 {
	tls internal
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:8000
	}
	handle /admin/* {
		reverse_proxy server:8000
	}
	handle /healthz {
		reverse_proxy server:8000
	}
	handle {
		reverse_proxy server:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
