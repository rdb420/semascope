<?xml version="1.0" encoding="UTF-8" ?>
<!-- Semascope "chunks" schema: passage text and one dense vector per chunk (Solr 10).
     A DenseVectorField has a fixed dimension, so there is one vector field per supported
     dimension and each chunk fills the one that matches its embedding model:
     `vector` for 384 dimensions (the bundled bge-small; the only field in 1.0.0-rc.2),
     `vector_<n>` for the others. Keep this list in sync with oss_core.vectors.DIMENSIONS. -->
<schema name="semascope-chunks" version="1.7">
  <uniqueKey>id</uniqueKey>
  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_version_" type="plong" indexed="false" stored="false"/>
  <field name="document_id" type="string" indexed="true" stored="true" required="true" docValues="true"/>
  <field name="collection_s" type="string" indexed="true" stored="true" required="true" docValues="true"/>
  <field name="position_i" type="pint" indexed="true" stored="true" docValues="true"/>
  <field name="page_i" type="pint" indexed="true" stored="true" docValues="true"/>
  <field name="text_txt" type="text_general" indexed="true" stored="true"/>
  <field name="vector" type="knn_vector_384" indexed="true" stored="false"/>
  <field name="vector_256" type="knn_vector_256" indexed="true" stored="false"/>
  <field name="vector_512" type="knn_vector_512" indexed="true" stored="false"/>
  <field name="vector_768" type="knn_vector_768" indexed="true" stored="false"/>
  <field name="vector_1024" type="knn_vector_1024" indexed="true" stored="false"/>
  <field name="vector_1536" type="knn_vector_1536" indexed="true" stored="false"/>
  <field name="vector_2560" type="knn_vector_2560" indexed="true" stored="false"/>
  <field name="vector_3072" type="knn_vector_3072" indexed="true" stored="false"/>
  <field name="vector_4096" type="knn_vector_4096" indexed="true" stored="false"/>
  <field name="model_s" type="string" indexed="true" stored="true" docValues="true"/>

  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="knn_vector_256" class="solr.DenseVectorField" vectorDimension="256" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_384" class="solr.DenseVectorField" vectorDimension="384" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_512" class="solr.DenseVectorField" vectorDimension="512" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_768" class="solr.DenseVectorField" vectorDimension="768" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_1024" class="solr.DenseVectorField" vectorDimension="1024" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_1536" class="solr.DenseVectorField" vectorDimension="1536" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_2560" class="solr.DenseVectorField" vectorDimension="2560" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_3072" class="solr.DenseVectorField" vectorDimension="3072" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="knn_vector_4096" class="solr.DenseVectorField" vectorDimension="4096" similarityFunction="cosine" knnAlgorithm="hnsw" hnswMaxConnections="16" hnswBeamWidth="100"/>
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
      <filter name="asciiFolding"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="stop" ignoreCase="true" words="lang/stopwords_en.txt"/>
      <filter name="lowercase"/>
      <filter name="asciiFolding"/>
    </analyzer>
  </fieldType>
</schema>
