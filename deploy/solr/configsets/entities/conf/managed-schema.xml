<?xml version="1.0" encoding="UTF-8" ?>
<!-- Semascope "entities" dictionary schema for the Solr 10 Tagger handler. -->
<schema name="semascope-entities" version="1.7">
  <uniqueKey>id</uniqueKey>

  <field name="id" type="string" indexed="true" stored="true" required="true"/>
  <field name="_version_" type="plong" indexed="false" stored="false"/>
  <field name="iri" type="string" indexed="true" stored="true" required="true" docValues="true"/>
  <field name="pack_id" type="string" indexed="true" stored="true" required="true" docValues="true"/>
  <field name="pack_version" type="string" indexed="true" stored="true" required="true" docValues="true"/>
  <field name="label" type="string" indexed="true" stored="true" required="true"/>
  <field name="label_tag" type="tag" indexed="true" stored="false"/>
  <field name="label_txt" type="text_label" indexed="true" stored="false"/>
  <field name="label_s" type="string" indexed="true" stored="false"/>
  <field name="pref_label" type="string" indexed="false" stored="true"/>
  <field name="label_type" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="lang" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="kind" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="type_iri" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="scheme" type="string" indexed="true" stored="true" docValues="true"/>
  <field name="path" type="string" indexed="true" stored="true"/>
  <!-- Every facet path of the term (one per broader chain in a polyhierarchy); `path` is the first. -->
  <field name="paths" type="string" indexed="true" stored="true" multiValued="true"/>
  <field name="case_sensitive" type="boolean" indexed="true" stored="true"/>
  <!-- Set on a curator's draft label only: the collection that proposed it, the only one it tags. -->
  <field name="collection_scope" type="string" indexed="true" stored="true" docValues="true"/>
  <!-- The dictionary sync that wrote the entry: a sync adds its entries, then deletes the
       pack version's entries of other syncs, so tagging never sees an empty dictionary. -->
  <field name="sync" type="string" indexed="true" stored="true" docValues="true"/>

  <copyField source="label" dest="label_tag"/>
  <copyField source="label" dest="label_txt"/>
  <copyField source="label" dest="label_s"/>

  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>

  <!-- The Tagger dictionary type: FST postings, whole-label concatenation at index time. -->
  <fieldType name="tag" class="solr.TextField" postingsFormat="FST50" omitNorms="true" omitTermFreqAndPositions="true" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="englishPossessive"/>
      <filter name="asciiFolding"/>
      <filter name="lowercase"/>
      <filter name="concatenateGraph" preservePositionIncrements="false"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="englishPossessive"/>
      <filter name="asciiFolding"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>

  <fieldType name="text_label" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer name="standard"/>
      <filter name="asciiFolding"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>
</schema>
