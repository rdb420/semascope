<?xml version="1.0" encoding="UTF-8"?>
<!-- Semascope Tika 3 server configuration. OCR is on for images and for
     PDFs that have no text layer; inline images in PDFs are not OCRed by
     default because that multiplies cost. -->
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <parser-exclude class="org.apache.tika.parser.ocr.TesseractOCRParser"/>
    </parser>
    <parser class="org.apache.tika.parser.ocr.TesseractOCRParser">
      <params>
        <param name="language" type="string">eng</param>
        <param name="timeoutSeconds" type="int">120</param>
        <param name="skipOcr" type="bool">false</param>
      </params>
    </parser>
    <parser class="org.apache.tika.parser.pdf.PDFParser">
      <params>
        <param name="ocrStrategy" type="string">AUTO</param>
        <param name="extractInlineImages" type="bool">false</param>
        <param name="sortByPosition" type="bool">true</param>
      </params>
    </parser>
  </parsers>
</properties>
