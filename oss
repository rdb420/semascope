#!/usr/bin/env bash
# Semascope entry point. Runs the `oss` CLI inside the app image so no host
# Python is needed. Developers can call `uv run oss ...` directly instead.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
cmd="${1:-help}"
# SEMASCOPE_ENV_FILE picks another env file (the integration stack uses .env.ci);
# compose then reads it for variable substitution too.
env_file="${SEMASCOPE_ENV_FILE:-.env}"
if [ "$env_file" != .env ]; then export SEMASCOPE_ENV_FILE COMPOSE_ENV_FILES="${COMPOSE_ENV_FILES:-$env_file}"; fi
# The runtime chosen at `oss init` picks the compose overlay for every command below.
runtime="$(grep -E '^SEMASCOPE_RUNTIME=' "$env_file" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
case "${runtime:-cpu}" in
  gpu) export COMPOSE_FILE="${COMPOSE_FILE:-compose.yaml:compose.gpu.yaml}" ;;
esac
# Valkey requires a password from 1.0.0-rc.4 on. An env file written before then gets a
# generated VALKEY_PASSWORD on the next `./oss up`; Valkey reads it at start, nothing else
# changes. (`oss init` writes one for new installs.)
ensure_valkey_password() {
  [ -f "$env_file" ] || return 0
  if grep -qE '^VALKEY_PASSWORD=[^[:space:]]+' "$env_file"; then return 0; fi
  local password tmp
  password="$(head -c 24 /dev/urandom | base64 | tr -d '+/=\n')"
  tmp="$env_file.tmp.$$"
  { grep -v '^VALKEY_PASSWORD=' "$env_file" || true; printf 'VALKEY_PASSWORD=%s\n' "$password"; } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$env_file"
  echo "added a generated VALKEY_PASSWORD to $env_file (Valkey now requires a password)"
}
# --- backup and restore -----------------------------------------------------------------------
# Every step fails loudly: a non-zero exit and a message naming the step. A restore checks the
# whole backup first and loads it beside the live data (a staging Solr collection per
# collection, a separate Postgres database), so a backup that cannot be read changes nothing.
SOLR_COLLECTIONS="documents entities chunks"

fail() { echo "error: $*" >&2; exit 1; }

# solr_api <query>: a Collections API call inside the Solr container; fails unless status 0
solr_api() {
  docker compose exec -T solr sh -c '
    out="$(curl -sS -u "semascope:$SEMASCOPE_SOLR_PASSWORD" "http://localhost:8983/solr/admin/collections?$1&wt=json")" || exit 1
    if printf "%s" "$out" | grep -Eq "\"status\"[[:space:]]*:[[:space:]]*0([^0-9]|\$)" \
      && ! printf "%s" "$out" | grep -q "\"failure\""; then exit 0; fi
    printf "%s\n" "$out" | head -c 2000 >&2; exit 1' sh "$1"
}

# solr_backup <collection>: back the collection up inside the Solr container; the tar on stdout
solr_backup() {
  docker compose exec -T solr sh -c '
    set -e
    dir="/var/solr/data/backup-$1"
    rm -rf "$dir" && mkdir -p "$dir"
    out="$(curl -sS -u "semascope:$SEMASCOPE_SOLR_PASSWORD" "http://localhost:8983/solr/admin/collections?action=BACKUP&name=$1&collection=$1&location=$dir&wt=json")"
    if ! printf "%s" "$out" | grep -Eq "\"status\"[[:space:]]*:[[:space:]]*0([^0-9]|\$)" \
      || printf "%s" "$out" | grep -q "\"failure\""; then
      printf "%s\n" "$out" | head -c 2000 >&2; exit 1
    fi
    [ -n "$(ls -A "$dir")" ] || { echo "Solr wrote no backup files for $1" >&2; exit 1; }
    tar -C "$dir" -cf - .' sh "$1"
}

backup() {
  local dest c
  dest="${1:-./data/backups/$(date -u +%Y%m%dT%H%M%SZ)}"
  mkdir -p "$dest/solr"
  echo "postgres -> $dest/postgres.sql.gz"
  docker compose exec -T postgres pg_dump -U semascope -d semascope | gzip > "$dest/postgres.sql.gz" \
    || fail "backup FAILED: pg_dump; $dest is incomplete"
  gzip -t "$dest/postgres.sql.gz" || fail "backup FAILED: $dest/postgres.sql.gz is unreadable"
  echo "solr collections -> $dest/solr/"
  for c in $SOLR_COLLECTIONS; do
    solr_backup "$c" > "$dest/solr/$c.tar" || fail "backup FAILED: Solr collection $c; $dest is incomplete"
    tar -tf "$dest/solr/$c.tar" | grep -q . || fail "backup FAILED: $dest/solr/$c.tar is empty or unreadable"
  done
  echo "blobs, previews, uploads, pack store -> $dest/data.tar.gz"
  docker compose run --rm -T cli sh -c "tar -C /data -czf - --exclude=static --exclude=celerybeat-schedule ." > "$dest/data.tar.gz" \
    || fail "backup FAILED: the data volume; $dest is incomplete"
  gzip -t "$dest/data.tar.gz" || fail "backup FAILED: $dest/data.tar.gz is unreadable"
  if [ "${2:-}" = "--with-graph" ]; then
    echo "neo4j (stopped for the dump) -> $dest/neo4j.dump"
    docker compose stop neo4j >/dev/null
    local rc=0
    docker compose run --rm -T --no-deps neo4j neo4j-admin database dump neo4j --to-stdout > "$dest/neo4j.dump" || rc=$?
    docker compose start neo4j >/dev/null || fail "neo4j did not start again after the dump; run ./oss up"
    [ "$rc" = 0 ] && [ -s "$dest/neo4j.dump" ] || fail "backup FAILED: the Neo4j dump; $dest is incomplete"
  else
    echo "graph not dumped: it is a projection; 'oss reindex' rebuilds it (pass --with-graph to dump it)"
  fi
  cp .env.example "$dest/env.example"
  echo "done: $dest (keep your .env with it; it holds the secrets the backup needs)"
}

# verify_backup <dir>: every file a restore needs is present and readable
verify_backup() {
  local src="$1" c
  [ -f "$src/postgres.sql.gz" ] || fail "no postgres.sql.gz in $src"
  gzip -t "$src/postgres.sql.gz" 2>/dev/null || fail "$src/postgres.sql.gz is corrupt"
  [ -f "$src/data.tar.gz" ] || fail "no data.tar.gz in $src"
  tar -tzf "$src/data.tar.gz" >/dev/null 2>&1 || fail "$src/data.tar.gz is corrupt"
  for c in $SOLR_COLLECTIONS; do
    [ -f "$src/solr/$c.tar" ] || fail "no solr/$c.tar in $src"
    tar -tf "$src/solr/$c.tar" 2>/dev/null | grep -q . || fail "$src/solr/$c.tar is empty or corrupt"
  done
  if [ -e "$src/neo4j.dump" ]; then [ -s "$src/neo4j.dump" ] || fail "$src/neo4j.dump is empty"; fi
}

restore() {
  local src="${1:?usage: ./oss restore <backup-dir>}" c staged=""
  echo "checking $src"
  verify_backup "$src"
  echo "stopping app services"
  docker compose stop server worker beat >/dev/null

  # Until the switch below, a failure leaves the live data as it was.
  undo() {
    echo "error: restore FAILED: $1" >&2
    for c in $staged; do solr_api "action=DELETE&name=${c}_restoring" 2>/dev/null || true; done
    docker compose exec -T postgres psql -q -U semascope -d postgres \
      -c "DROP DATABASE IF EXISTS semascope_restore" >/dev/null 2>&1 || true
    docker compose up -d --wait server worker beat >/dev/null || true
    echo "nothing was changed; the app services are running again on the existing data" >&2
    exit 1
  }
  for c in $SOLR_COLLECTIONS; do
    echo "solr $c <- $src/solr/$c.tar (staged as ${c}_restoring)"
    docker compose exec -T solr sh -c 'set -e; d="/var/solr/data/restore-$1"; rm -rf "$d"; mkdir -p "$d"; tar -C "$d" -xf -' sh "$c" \
      < "$src/solr/$c.tar" || undo "unpacking solr/$c.tar"
    solr_api "action=DELETE&name=${c}_restoring" >/dev/null 2>&1 || true
    staged="$staged $c"
    solr_api "action=RESTORE&name=$c&collection=${c}_restoring&location=/var/solr/data/restore-$c" \
      || undo "Solr could not restore $c from the backup"
  done
  echo "postgres <- $src/postgres.sql.gz (staged as semascope_restore)"
  docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -q -U semascope -d postgres \
    -c "DROP DATABASE IF EXISTS semascope_restore" -c "CREATE DATABASE semascope_restore OWNER semascope" >/dev/null \
    || undo "creating the staging database"
  gunzip -c "$src/postgres.sql.gz" | docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -q -U semascope -d semascope_restore >/dev/null \
    || undo "loading postgres.sql.gz"

  # The switch: from here a failure is reported with what is where.
  echo "switching to the restored data"
  docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -q -U semascope -d postgres \
    -c "DROP DATABASE IF EXISTS semascope_before_restore" \
    -c "ALTER DATABASE semascope RENAME TO semascope_before_restore" \
    -c "ALTER DATABASE semascope_restore RENAME TO semascope" >/dev/null \
    || fail "restore FAILED switching Postgres databases: check that 'semascope' exists (the previous one may be 'semascope_before_restore', the restored one 'semascope_restore'); the app services are stopped"
  echo "data <- $src/data.tar.gz"
  docker compose run --rm -T cli sh -c "tar -C /data -xzf -" < "$src/data.tar.gz" \
    || fail "restore FAILED unpacking data.tar.gz into the data volume; Postgres is restored, Solr not yet (staged as *_restoring); the app services are stopped"
  for c in $SOLR_COLLECTIONS; do
    echo "solr $c: replacing with the restored copy"
    solr_api "action=DELETE&name=$c" || fail "restore FAILED deleting Solr collection $c; the restored copy is ${c}_restoring; the app services are stopped"
    solr_api "action=RESTORE&name=$c&collection=$c&location=/var/solr/data/restore-$c" \
      || fail "restore FAILED restoring Solr collection $c (it was deleted); the restored copy is ${c}_restoring; the app services are stopped"
    solr_api "action=DELETE&name=${c}_restoring" || echo "warning: could not delete the staging collection ${c}_restoring" >&2
    docker compose exec -T solr rm -rf "/var/solr/data/restore-$c" || true
  done
  if [ -f "$src/neo4j.dump" ]; then
    echo "neo4j <- $src/neo4j.dump"
    docker compose stop neo4j >/dev/null
    local rc=0
    docker compose run --rm -T --no-deps neo4j neo4j-admin database load neo4j --from-stdin --overwrite-destination=true < "$src/neo4j.dump" || rc=$?
    docker compose start neo4j >/dev/null || fail "neo4j did not start again after the load; run ./oss up"
    [ "$rc" = 0 ] || fail "restore FAILED loading neo4j.dump; Postgres, Solr and the data volume are restored; './oss reindex' rebuilds the graph"
  fi
  docker compose exec -T postgres psql -q -U semascope -d postgres \
    -c "DROP DATABASE IF EXISTS semascope_before_restore" >/dev/null \
    || echo "warning: could not drop the previous database semascope_before_restore" >&2
  docker compose up -d --wait server worker beat >/dev/null || fail "the app services did not come back; see ./oss logs server"
  echo "restored from $src; run ./oss doctor"
}

case "$cmd" in
  init)
    shift; exec uv run --package oss-cli oss init --env-file "$env_file" "$@" ;;
  up)
    ensure_valkey_password
    docker compose pull --ignore-buildable 2>/dev/null || true
    docker compose up -d --wait; exec docker compose run --rm cli oss doctor ;;
  down)
    exec docker compose down ;;
  logs)
    shift; exec docker compose logs -f "$@" ;;
  index)
    shift
    import_dir="$(grep -E '^SEMASCOPE_IMPORT_DIR=' "$env_file" 2>/dev/null | cut -d= -f2- | sed 's/[[:space:]]*#.*//' || true)"
    import_dir="$(cd "${import_dir:-./data/import}" 2>/dev/null && pwd -P || echo "")"
    target="$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)/$(basename "$1")"
    case "$target" in
      "$import_dir"|"$import_dir"/*) inside="/import${target#"$import_dir"}" ;;
      *) echo "$1 is outside SEMASCOPE_IMPORT_DIR ($import_dir); move it there or change the setting in $env_file" >&2; exit 2 ;;
    esac
    exec docker compose run --rm cli oss index "$inside" "${@:2}" ;;
  backup)
    shift
    backup "$@" ;;
  restore)
    shift
    restore "$@" ;;
  doctor|demo|reindex|version|search|stats|upload|pack)
    exec docker compose run --rm cli oss "$@" ;;
  help|-h|--help)
    cat <<'USAGE'
usage: ./oss <command>

  init      write .env with generated secrets (needs uv on the host)
  up        start every service and wait for health
  down      stop everything (data volumes are kept)
  logs      follow service logs
  doctor    check connectivity, versions and schema versions
  demo      load the public-domain demo corpus and pack
  index     index a path into a collection
  reindex   replay a collection from stored extraction
  backup    dump Postgres, the Solr collections and the data volume into ./data/backups/<stamp> (--with-graph adds Neo4j)
  restore   restore from a backup directory (stops the app services while it runs)
  version   print the product version
  pack      pack import|list|validate
  upload    upload files through the API
  search    search a collection (--mode keyword|semantic|hybrid)
  stats     counts of collections, sources and documents
USAGE
    ;;
  *)
    # anything else is handed to the CLI inside the stack (`oss --help` lists it)
    exec docker compose run --rm cli oss "$@" ;;
esac
