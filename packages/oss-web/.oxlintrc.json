{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // These export a hook (useUser) or the search route's param parser and
      // snippet sanitiser next to the component; fast refresh then reloads the
      // module in full, which only matters in development.
      "files": ["src/components/Shell.tsx", "src/pages/SearchPage.tsx"],
      "rules": { "react/only-export-components": "off" }
    }
  ]
}
