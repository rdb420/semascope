@prefix ex: <https://example.test/birds#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:kookaburra a ex:Bird ;
    rdfs:label "Laughing kookaburra" ;
    ex:habitat ex:woodland ;
    ex:note "Its call sounds like loud laughter at dawn." .

ex:lyrebird a ex:Bird ;
    skos:prefLabel "Superb lyrebird" ;
    ex:habitat ex:rainforest ;
    ex:note "Mimics chainsaws and camera shutters." .

ex:woodland a ex:Habitat ;
    rdfs:label "Open woodland" .
